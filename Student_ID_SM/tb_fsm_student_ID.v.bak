`timescale 1ns/1ps

module tb_fsm_student_ID;

    reg clk;
    reg rst_n;
    reg [3:0] user_input;
    reg start;

    wire active;
    wire done;
    wire [3:0] out_digit;

  
    fsm_student_ID uut (
        .clk(clk),
        .rst_n(rst_n),
        .user_input(user_input),
        .output_digit(out_digit), 
        .start(start),
        .Done(done),
        .active(active)
    );


    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end


    initial begin

        $display("=== BAT DAU MO PHONG MSSV: 23520200 ===");
        rst_n = 0;
        start = 0;
        user_input = 0;
        #10;            
        rst_n = 1;      
        #10;


        $display("\n--- [CASE 1] Input = 2. Expect: 2 -> 3 -> 5 -> 2 -> 0 -> 2 -> 0 -> 0 ---");
        
        @(posedge clk); 
        user_input = 4'd2; 
        start = 1;      
        @(posedge clk); 
        start = 0;      

        
        wait(done == 1);
		  rst_n = 0;
        @(posedge clk); 
        #20; 

        
        $display("\n--- [CASE 2] Input = 3. Expect: 3 -> 5 -> 2 -> 0 -> 2 -> 0 -> 0 ---");

        @(posedge clk);
        user_input = 4'd3;
        start = 1;
        @(posedge clk);
        start = 0;

        wait(done == 1);
		  rst_n = 0;
        @(posedge clk);
        #20;

        
        $display("\n--- [CASE 3] Input = 0. Expect: 0 -> 2 -> 0 -> 2 -> 0 -> 0 ---");


        @(posedge clk);
        user_input = 4'd0; 
        start = 1;
        @(posedge clk);
        start = 0;

        wait(done == 1);
		  rst_n = 0;
        @(posedge clk);
        #20;

        $display("\n--- [CASE 4] Input = 9. Expect: Default (Full Sequence) ---");

        @(posedge clk);
        user_input = 4'd9; 
        start = 1;
        @(posedge clk);
        start = 0;

        wait(done == 1);
		  rst_n = 0;
		  @(posedge clk);
        
        $display("\n=== HOAN THANH MO PHONG ===");
        $stop; 
    end


    initial begin
        $timeformat(-9, 0, " ns", 6);
        $monitor("Time: %t | Active: %b | State Output: %d | Done: %b", 
                 $time, active, out_digit, done);
    end

endmodule