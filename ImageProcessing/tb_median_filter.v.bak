`timescale 1ns/1ps

module tb_median();

    // === CHANGE THESE TO MATCH YOUR IMAGE ===
    parameter WIDTH = 256;   // e.g., 256, 512, 1920
    parameter HEIGHT = 256;  
    parameter SIZE = WIDTH * HEIGHT;
    // ========================================

    reg [7:0] img_mem [0:SIZE-1]; // Memory to store the image
    reg [7:0] p1, p2, p3, p4, p5, p6, p7, p8, p9;
    wire [7:0] out_pixel;
    
    integer file_read, file_write, i, x, y, scan_status;

    // Instantiate the Median Filter
    median_filter uut (
        .p1(p1), .p2(p2), .p3(p3),
        .p4(p4), .p5(p5), .p6(p6),
        .p7(p7), .p8(p8), .p9(p9),
        .median_out(out_pixel)
    );

    initial begin
        // 1. Open Files
        // If your txt file is DECIMAL, use $fopen and $fscanf loop.
        // If your txt file is HEX, use $readmemh("pic_input.txt", img_mem);
        
        // --- DECIMAL READ METHOD (Robust for your current file) ---
        file_read = $fopen("pic_input.txt", "r");
        if (file_read == 0) begin
            $display("ERROR: Cannot open pic_input.txt");
            $finish;
        end
        
        for (i = 0; i < SIZE; i = i + 1) begin
            scan_status = $fscanf(file_read, "%d\n", img_mem[i]);
        end
        $fclose(file_read);
        // ---------------------------------------------------------

        file_write = $fopen("pic_output.txt", "w");

        // 2. Sliding Window Loop (Ignores borders 1 pixel wide)
        for (y = 0; y < HEIGHT; y = y + 1) begin
            for (x = 0; x < WIDTH; x = x + 1) begin
                
                // Handle Borders: Just copy the pixel, or process 3x3 only for inner pixels
                if (x == 0 || x == WIDTH-1 || y == 0 || y == HEIGHT-1) begin
                    $fwrite(file_write, "%0d\n", img_mem[y*WIDTH + x]);
                end else begin
                    // Extract 3x3 Window from 1D array
                    // y*WIDTH + x is the current pixel index
                    
                    // Row Above
                    p1 = img_mem[(y-1)*WIDTH + (x-1)]; 
                    p2 = img_mem[(y-1)*WIDTH + (x)];
                    p3 = img_mem[(y-1)*WIDTH + (x+1)];
                    
                    // Current Row
                    p4 = img_mem[(y)*WIDTH + (x-1)];
                    p5 = img_mem[(y)*WIDTH + (x)];   // Center
                    p6 = img_mem[(y)*WIDTH + (x+1)];
                    
                    // Row Below
                    p7 = img_mem[(y+1)*WIDTH + (x-1)];
                    p8 = img_mem[(y+1)*WIDTH + (x)];
                    p9 = img_mem[(y+1)*WIDTH + (x+1)];

                    #10; // Wait for the "always" block to finish
                    
                    // Write filtered pixel to file
                    $fwrite(file_write, "%0d\n", out_pixel);
                end
            end
        end

        $fclose(file_write);
        $display("Processing Complete. Output saved to pic_output.txt");
        $finish;
    end
endmodule